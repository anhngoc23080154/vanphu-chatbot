{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**,data/**,supabase/**,.venv/**,**/__pycache__/**,**/*.pyc,pytest.ini,requirements-dev.txt,README.md}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 3 * * *"
    }
  ]
}
