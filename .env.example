# ---------------------------------------------------------------------------
# Chatbot Văn Phú - TOÀN BỘ biến môi trường của dự án nằm trong MỘT file .env
# duy nhất ở thư mục gốc này, dùng chung cho cả backend và frontend.
#
# Cách dùng: sao chép file này thành .env rồi điền giá trị.
#     cp .env.example .env
#
# Backend (FastAPI) đọc file này qua pydantic-settings.
# Frontend (Vite) cũng đọc file này nhờ tuỳ chọn envDir trong vite.config.ts,
# nhưng CHỈ nhúng vào mã trình duyệt các biến có tiền tố VITE_. Vì vậy
# GEMINI_API_KEY và SUPABASE_SECRET_KEY nằm cùng file vẫn an toàn.
#
# Trên Vercel: khai báo trong Project Settings > Environment Variables.
# ---------------------------------------------------------------------------


# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
# Model sinh câu trả lời. Nếu bị 429/503 sẽ tự chuyển sang model trong danh sách dự phòng.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Số chiều vector. Phải khớp với vector(768) trong supabase/001_schema.sql.
EMBED_DIM=768

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
# Secret key (service role) - bỏ qua RLS. KHÔNG để lộ ra frontend.
SUPABASE_SECRET_KEY=
# Bucket public chứa ảnh/poster dự án.
MEDIA_BUCKET=media
# SUPABASE_PUBLISHABLE_KEY và SUPABASE_JWKS_URL hiện chưa dùng
# (dành cho bước sau nếu bổ sung xác thực người dùng).

# --- API ------------------------------------------------------------------
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chuỗi bí mật cho cron keep-alive Supabase.
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Để trống ở local => endpoint /api/cron/keepalive không yêu cầu xác thực.
CRON_SECRET=

# --- Tinh chỉnh RAG -------------------------------------------------------
TOP_K=6
MEDIA_SIM_THRESHOLD=0.72
UNITS_LIMIT=20
# Gemini tính hạn mức embedding theo TỪNG đoạn trong lô, không theo số lần gọi.
# Giảm hai giá trị này nếu vẫn gặp lỗi 429 khi nạp dữ liệu.
EMBED_ITEMS_PER_MINUTE=80
EMBED_BATCH_SIZE=25
LOG_LEVEL=INFO

# --- Frontend (Vite) ------------------------------------------------------
# Base URL của backend.
# Để TRỐNG khi chạy dev (Vite proxy /api sang http://localhost:8000) và khi
# deploy một project Vercel duy nhất (frontend gọi /api/chat cùng nguồn gốc).
# Chỉ điền khi tách thành hai project Vercel riêng.
VITE_API_BASE_URL=

# true = dùng câu trả lời giả lập, không gọi backend (chỉ để test giao diện).
VITE_CHAT_MOCK=false
